[gd_resource type="Resource" script_class="BattleDialogue" format=3]

[ext_resource type="Script" path="res://Combate/dialogos/battle_dialogue.gd" id="1_bd"]
[ext_resource type="Script" path="res://overworld/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://overworld/dialogue/dialogue_option.gd" id="3_opt"]

[sub_resource type="Resource" id="Resource_r1"]
script = ExtResource("2_node")
lines = PackedStringArray("Sabia decisión... Llévatelos.")

[sub_resource type="Resource" id="Resource_o1"]
script = ExtResource("3_opt")
text = "Rendirme"
reply = SubResource("Resource_r1")
set_flag = &"rendido_ante_jefe"
end_battle = 2

[sub_resource type="Resource" id="Resource_r2"]
script = ExtResource("2_node")
lines = PackedStringArray("¡Qué valentía! Toma, te lo has ganado.")

[sub_resource type="Resource" id="Resource_o2"]
script = ExtResource("3_opt")
text = "Seguir luchando"
reply = SubResource("Resource_r2")
heroes_hp_percent = 20
give_item = &"mushroom"

[sub_resource type="Resource" id="Resource_c"]
script = ExtResource("2_node")
lines = PackedStringArray("Estás en las últimas... ¿Te rindes?")
options = Array[ExtResource("3_opt")]([SubResource("Resource_o1"), SubResource("Resource_o2")])

[resource]
script = ExtResource("1_bd")
when = 7
conversation = SubResource("Resource_c")
speaker = "Enemigo"
