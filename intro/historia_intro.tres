[ext_resource type="Script" uid="uid://dl57dtfngyclt" path="res://intro/intro_sequence.gd" id="1_seq"]
[ext_resource type="Script" uid="uid://bvb82memntkf1" path="res://intro/intro_slide.gd" id="2_slide"]
