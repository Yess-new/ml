[ext_resource type="Texture2D" uid="uid://db33y5ng0u2ec" path="res://Sprites/intro/ilustracion/sello.png" id="9_ad10g"]
[ext_resource type="Texture2D" uid="uid://070nrum8mmdl" path="res://Sprites/intro/ilustracion/comunicacion.png" id="10_cwvfc"]
